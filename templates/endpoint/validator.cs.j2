using FluentValidation;
using Microsoft.Extensions.Localization;
using MyErp6.Domain.Shared.Localization;
using MyErp6.Application.Contracts.Repositories;
using TmtCo.Localization;
using TMT.MyErp6.CommandUseCases.{{ feature_name_plural }}.Commands;

namespace TMT.MyErp6.Application.{{ feature_name_plural }}.Validators
{
    /// <summary>
    /// Validates {{ request_name }} before it reaches the command handler.
    /// </summary>
    public sealed class {{ request_name }}Validator : AbstractValidator<{{ request_name }}>
    {
        /// <summary>
        /// Builds localized validation rules for {{ request_name }}.
        /// </summary>
        public {{ request_name }}Validator(IStringLocalizer<ValidationMessages> L)
        {
{% for rule in computed_rules %}
            RuleFor(x => {{ rule.target }})
                .{{ rule.kind }}{% if rule.original_kind == "MaxLength" %}({{ rule.max_value }}){% endif %}

{% if rule.message_key %}
                .WithMessage(_ => L[{{ rule.message_key }}]);
{% endif %}

{% endfor %}
        }
    }
}
